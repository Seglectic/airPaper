# ┌─────────────────────────────────────────────┐
# │           airPaper — Environment Config     │
# └─────────────────────────────────────────────┘
# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ── Required ────────────────────────────────────
PAPERLESS_KEY=your-paperless-api-token
AIRTABLE_KEY=your-airtable-personal-access-token
AIRTABLE_BASE_ID=your-airtable-base-id

# ── Airtable config ─────────────────────────────
ACTIVE_TABLE=Work Orders
# Table used when TESTING=true — keeps test runs out of the live table
TEST_TABLE=Paperless Work Orders
# Field name for multi-file production documents (traveler, drawings, STEP files)
PART_DOCUMENTS_FIELD=Part Documents

# ── Polling ──────────────────────────────────────
# How often to check Paperless for new orders (milliseconds, default 2 min)
UPDATE_INTERVAL=120000
# Set to true to use TEST_TABLE and freeze the order cursor
TESTING=false

# ── Xometry enrichment (optional) ────────────────
# If set, Xometry orders are detected by client name and enriched with job files
XOMETRY_API_TOKEN=your-xometry-api-token
# Comma-separated list of customer name substrings that indicate a Xometry order
XOMETRY_CUSTOMER_NAME_MATCHES=Xometry

# ── Advanced ─────────────────────────────────────
# Override the default state file path
STATE_FILE_PATH=./data/state.json
